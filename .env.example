# Runtime mode
MOCK_MODE=true

# Durable local/container paths
AUTORESEARCH_EXPERIMENTS_DIR=/data/experiments
AUTORESEARCH_ARTIFACTS_DIR=/data/artifacts
BACKEND_URL=http://127.0.0.1:8000

# Budget/audit labels. Keep labels in logs, never raw keys.
PARENT_API_KEY_ID=key-1
CHILD_A_API_KEY_ID=key-2
CHILD_B_API_KEY_ID=key-3

# Anthropic physical keys. If role-specific keys are unset, all roles fall back
# to ANTHROPIC_API_KEY. For now, you can set only ANTHROPIC_API_KEY and the
# system will behave as three logical pods sharing one real key.
# ANTHROPIC_API_KEY=
# PARENT_ANTHROPIC_API_KEY=
# CHILD_A_ANTHROPIC_API_KEY=
# CHILD_B_ANTHROPIC_API_KEY=

# Anthropic model policy. Strong/medium/weak are used by simple heuristics.
ANTHROPIC_STRONG_MODEL=claude-opus-4-1-20250805
ANTHROPIC_MEDIUM_MODEL=claude-sonnet-4-20250514
ANTHROPIC_WEAK_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_PARENT_MODEL=claude-opus-4-1-20250805
ANTHROPIC_STRONG_CHILD_MODEL=claude-opus-4-1-20250805
ANTHROPIC_CHILD_MODEL=claude-sonnet-4-20250514
ANTHROPIC_TEST_MODEL=claude-3-5-haiku-20241022

# Child code patches need room for complete full-file replacements. If this is
# too low, the API may return truncated JSON that cannot be applied.
ANTHROPIC_CHILD_MAX_OUTPUT_TOKENS=6000
